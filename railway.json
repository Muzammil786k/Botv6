{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @workspace/api-server run build"
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @workspace/db run migrate", "pnpm --filter @workspace/db run push"],
    "startCommand": "pnpm --filter @workspace/api-server run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}