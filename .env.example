# HTTP server
PORT=5000

# PostgreSQL and Discord bot
DATABASE_URL=postgres://user:password@localhost:5432/mainv5
DISCORD_BOT_TOKEN=
BOT_OWNER_ID=

# Top.gg v1 vote webhook
# TOPGG_PROJECT_ID is the Discord application/bot ID from the Top.gg project.
TOPGG_PROJECT_ID=
# Copy the whs_... secret from the Top.gg project Webhooks page.
TOPGG_WEBHOOK_SECRET=

# Discadia custom vote webhook
# Configure URL as https://YOUR-HOST/api/discadia/webhook/<64-char-random-hex-token>.
# Generate a token with: openssl rand -hex 32
DISCADIA_WEBHOOK_SECRET=
